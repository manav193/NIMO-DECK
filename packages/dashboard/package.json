{
  "name": "@nimo-deck/dashboard",
  "version": "0.1.0",
  "description": "Shared React 19 developer command center and UI components for NIMO-DECK desktop and web applications",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@nimo-deck/shared": "*",
    "@tanstack/react-query": "^5.66.0",
    "lucide-react": "^1.70.0",
