{
  "name": "nimo-deck-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "NIMO-DECK Personal Development Operating System",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages/**/src/**/*.ts",
    "typecheck": "tsc -b packages/shared packages/core packages/sync packages/github packages/drive packages/intelligence",
    "clean": "node -e \"const fs = require('fs'); ['dist', 'build', '.turbo'].forEach(d => fs.rmSync(d, { recursive: true, force: true }));\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manav193/NIMO-DECK.git"
  },
  "keywords": [
    "git",
    "developer-os",
    "automation",
    "monorepo",
    "electron"
  ],
  "author": "Manav Patel <https://github.com/manav193>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/adm-zip": "^0.5.8",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "drizzle-orm": "^0.39.3",
    "eventemitter3": "^5.0.1",
    "zod": "^3.24.2"
  }
}
