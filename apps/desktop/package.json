{
  "name": "@nimo-deck/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NIMO-DECK Electron Desktop Application & Gateway",
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "electron ./dist/main/main.js",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\""
  },
  "build": {
    "appId": "io.github.manav193.nimodeck",
    "productName": "NIMO-DECK",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@nimo-deck/core": "*",
    "@nimo-deck/dashboard": "*",
    "@nimo-deck/drive": "*",
    "@nimo-deck/github": "*",
    "@nimo-deck/intelligence": "*",
    "@nimo-deck/shared": "*",
    "@nimo-deck/sync": "*",
    "@nimo-deck/vault": "*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "electron": "^35.0.0",
    "typescript": "~5.7.3"
  }
}
