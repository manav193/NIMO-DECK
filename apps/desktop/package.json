{
  "name": "@nimo-deck/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NIMO-DECK Electron Desktop Application & Gateway",
  "author": "Manav Patel <https://github.com/manav193>",
  "main": "./dist/main/main.js",
  "scripts": {
    "build:tsc": "tsc -b",
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --target=node22 --external:electron --external:better-sqlite3 --outfile=dist/main/main.js",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --target=node22 --external:electron --outfile=dist/preload/preload.js",
    "build:renderer": "vite build",
    "build": "npm run build:tsc && npm run build:main && npm run build:preload && npm run build:renderer",
    "package:win": "electron-builder --win",
    "package:dir": "electron-builder --win --dir",
    "start": "electron ./dist/main/main.js",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.rmSync('release', { recursive: true, force: true });\""
  },
  "build": {
    "appId": "io.github.manav193.nimodeck",
    "productName": "NIMO-DECK",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "script": "build/installer.nsi",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NIMO-DECK",
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@nimo-deck/core": "*",
    "@nimo-deck/dashboard": "*",
    "@nimo-deck/drive": "*",
    "@nimo-deck/github": "*",
    "@nimo-deck/intelligence": "*",
    "@nimo-deck/shared": "*",
    "@nimo-deck/sync": "*",
    "@nimo-deck/vault": "*",
    "better-sqlite3": "^13.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.7.3",
    "vite": "^7.3.7"
  }
}
